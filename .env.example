# URL base da API Spring Boot.
# Deixe em branco (ou remova o arquivo .env) para rodar em modo mock, com os
# candidatos guardados em memória no próprio navegador.
#
# Em desenvolvimento, com o proxy do Vite:
VITE_API_URL=/api
#
# Direto na API, se o back-end já libera CORS:
# VITE_API_URL=http://localhost:8080
